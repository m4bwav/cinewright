{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Character bible",
  "description": "bibles/characters.json: one identity string per character, copied verbatim into every card and prompt, plus wardrobe by scene.",
  "type": "object",
  "required": ["characters"],
  "additionalProperties": false,
  "properties": {
    "characters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "identity", "wardrobe"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "name": {"type": "string"},
          "identity": {"type": "string", "minLength": 20, "maxLength": 300, "description": "Age, build, face, hair, one distinctive mark. No wardrobe."},
          "voice": {"type": "string"},
          "wardrobe": {"type": "object", "required": ["default"], "additionalProperties": {"type": "string"}, "description": "default plus optional overrides keyed by scene id."},
          "props": {"type": "array", "items": {"type": "string"}},
          "refs": {"type": "array", "items": {"type": "string"}, "description": "Turnaround sheet or reference image ids."}
        }
      }
    }
  }
}
